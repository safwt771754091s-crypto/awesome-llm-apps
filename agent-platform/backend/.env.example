# Required: generate a long random secret and keep it only in the hosting provider's secret settings.
OWNER_API_TOKEN=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set true only if the database provider requires TLS. Certificate verification remains enabled.
DATABASE_SSL=false

# OpenAI-compatible model endpoint. Never put these values in the frontend.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=45000
PORT=8080
NODE_ENV=production
MAX_REQUEST_BYTES=20000
RATE_LIMIT_PER_MINUTE=20